{
  "manifest_version": 3,
  "name": "Image Translator (OCR)",
  "version": "1.8.0",
  "description": "Right-click to translate images and selected text. New: click the toolbar icon (or Alt+Shift+T) and drag a box to translate only that region in place.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequestWithHostAccess", "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Translate a selected region (框选翻译)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "selector.js",
        "content.js",
        "region.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
